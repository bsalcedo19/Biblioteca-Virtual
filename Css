.portada img {
    width: 100%;
    height: 80%;
    object-fit: cover;
    border-radius: 8px;
}



header {
    background-color: #243b2a;
    color: white;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar h1 {
    font-size: 22px;
}

.navbar ul {
    display: flex;
    gap: 20px;
    list-style: none;
}

.navbar a {
    color: white;
    text-decoration: none;
}

.navbar a:hover {
    color: #f4c95d;
}

.inicio {
    min-height: 500px;
    display: flex;
    align-items: center;
    padding: 50px 10%;
    background:
        linear-gradient(
            rgba(36, 59, 42, .85),
            rgba(36, 59, 42, .85)
        );
}

.inicio-texto {
    max-width: 600px;
    color: white;
}

.inicio h2 {
    font-size: 45px;
    margin-bottom: 20px;
}

.inicio p {
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 30px;
}

.boton {
    display: inline-block;
    background-color: #f4c95d;
    color: #243b2a;
    padding: 13px 25px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
}

.boton:hover {
    background-color: #e8b83e;
}

.libros {
    max-width: 1100px;
    margin: auto;
    padding: 70px 20px;
    text-align: center;
}

.libros h2 {
    font-size: 32px;
    color: #243b2a;
}

.descripcion {
    margin: 10px 0 25px;
}

.catalogo {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 25px;
}

.libro {
    background-color: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,.1);
    transition: .3s;
}

.libro:hover {
    transform: translateY(-8px);
}

.portada {
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #eee5d2;
    border-radius: 8px;
    font-size: 70px;
    margin-bottom: 15px;
}

.libro h3 {
    color: #243b2a;
    margin-bottom: 10px;
}

.libro p {
    color: #666;
    margin-bottom: 15px;
}

.libro button {
    border: none;
    background-color: #243b2a;
    color: white;
    padding: 10px 15px;
    border-radius: 6px;
    cursor: pointer;
}

.libro button:hover {
    background-color: #35583e;
}

.card {
    display: flex;
    flex-direction: column;
}

.button-info {
    margin-top: auto;
}
.nosotros {
    background-color: #e8e2d5;

    padding: 70px 20px;

    text-align: center;
}

.nosotros h2 {
    color: #243b2a;
    margin-bottom: 20px;
}

.nosotros p {
    max-width: 700px;
    margin: auto;

    line-height: 1.7;
}

.contacto {
    padding: 70px 20px;
    text-align: center;
}

.contacto h2 {
    color: #243b2a;
    margin-bottom: 20px;
}

.contacto p {
    margin: 8px;
}
